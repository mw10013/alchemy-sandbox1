# Copy to .env (untracked). Each checkout needs its own port.
WEBSITE_PORT=3900
# This checkout's Shopify dev store: sandbox-shop-00 in the main checkout, sandbox-shop-NN in
# worktree wt-NN. One store per checkout: two `shopify app dev` sessions on one store overwrite
# each other's app URL.
SHOPIFY_DEV_STORE=sandbox-shop-00
