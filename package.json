{
  "name": "alchemy-sandbox1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:alchemy": "bash -o pipefail -c 'stage=$(node scripts/stage.ts dev) && mkdir -p ./.logs/dev && NO_COLOR=1 alchemy dev --stage \"$stage\" 2>&1 | s6-log -b -l 65536 n20 s5242880 S104857600 T ./.logs/dev 1'",
    "dev": "node --env-file=.env scripts/dev.ts start",
    "dev:stop": "node --env-file=.env scripts/dev.ts stop",
    "dev:status": "node --env-file=.env scripts/dev.ts status",
    "dev:logs": "node scripts/dev.ts logs",
    "db:reset": "node --env-file=.env scripts/dev.ts db:reset",
    "worktree:init": "node scripts/worktree.ts init",
    "port": "node --env-file=.env -p \"process.env.WEBSITE_PORT ?? (console.error('WEBSITE_PORT is not set'), process.exit(1))\"",
    "test:e2e": "vp exec playwright test",
    "test:e2e:ui": "vp exec playwright test --ui",
    "test:e2e:server": "bash -c 'alchemy destroy --yes && exec alchemy dev'",
    "deploy:staging": "alchemy deploy --stage staging --yes",
    "refs": "node scripts/refs.ts",
    "refs:all": "node scripts/refs.ts fetch --all",
    "refs:check": "node scripts/refs.ts check"
  },
  "dependencies": {
    "@alchemy.run/better-auth": "2.0.0-beta.81",
    "@effect/atom-react": "4.0.1",
    "@effect/platform-node": "4.0.1",
    "@effect/sql-sqlite-do": "4.0.1",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "alchemy": "2.0.0-beta.81",
    "better-auth": "1.7.7",
    "effect": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "scheduler": "0.27.0"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare-runtime": "2.0.0-beta.81",
    "@cloudflare/workers-types": "5.20261006.1",
    "@effect/vitest": "4.0.1",
    "@shopify/polaris-types": "2.0.0-rc.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "2.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1"
}
